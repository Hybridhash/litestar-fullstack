# Shared variables (set on both web and worker services)
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
LITESTAR_DEBUG=false
VITE_DEV_MODE=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_UNIT=minute
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_EXCLUDE=/health,^/public/,^/saq/static/
RATE_LIMIT_EXCLUDE_OPT_KEY=disable_rate_limit
RATE_LIMIT_TRUST_PROXY_IP_HEADERS=false
RATE_LIMIT_TRUSTED_PROXY_CIDRS=

# Web service only
# Railway injects PORT at runtime.
LITESTAR_PORT=${{PORT}}
# Critical when running a dedicated worker service:
# prevents web process from spawning internal SAQ workers.
SAQ_USE_SERVER_LIFESPAN=false

# Worker service only
# Keep false so worker runtime is dedicated and explicit.
SAQ_USE_SERVER_LIFESPAN=false
# Disable SAQ web UI on worker in production.
SAQ_WEB_ENABLED=false
