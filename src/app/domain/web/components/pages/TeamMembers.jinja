{#def team=None, team_id="", member_total=0, query="" #}
<section class="space-y-6">
  <div class="flex flex-col gap-2">
    <p class="text-sm uppercase tracking-[0.2em] text-base-content/50">Team</p>
    <h1 class="text-3xl font-semibold">Team members</h1>
    <p class="max-w-2xl text-base-content/70">
      Manage members for {{ team.name if team else "this team" }}.
    </p>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body gap-4">
      <div class="flex min-w-0 flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0 space-y-3">
          <div class="text-sm text-base-content/60">{{ member_total }} members</div>
          <form class="flex w-full max-w-md flex-wrap gap-2 sm:flex-nowrap" hx-get="/api/teams/{{ team_id }}/members"
            hx-target="#team-members-table">
            <input name="q" value="{{ query }}" placeholder="Search by name or email"
              class="input input-bordered w-full sm:flex-1" type="search" />
            <button class="btn btn-secondary w-full sm:w-auto" type="submit">Apply</button>
          </form>
          <div id="team-members-feedback"></div>
        </div>
        <div class="card w-full max-w-sm bg-base-200/60">
          <div class="card-body">
            <h3 class="card-title text-lg">Add member</h3>
            <!-- HTMX events keep Alpine's loading state in sync with the request. -->
            <form class="space-y-3" x-data="htmxForm" hx-post="/api/teams/{{ team_id }}/members/add"
              hx-target="#team-members-table" hx-swap="innerHTML" data-htmx-reset-on-success="true"
              x-on:htmx:before-request.camel="startLoading()" x-on:htmx:after-request.camel="stopLoading()">
              <forms.TextField label="User email" name="user_name" type="email" placeholder="person@example.com"
                required={{ True }} />
              <forms.SelectField label="Role" name="role" options={{ [ {"value": "MEMBER" , "label" : "Member" },
                {"value": "ADMIN" , "label" : "Admin" } ] }} />
              <button class="btn btn-secondary btn-block" type="submit" :disabled="loading">
                <span x-show="!loading">Add member</span>
                <span x-show="loading">Adding...</span>
              </button>
            </form>
          </div>
        </div>
      </div>
      <div id="team-members-table" hx-get="/api/teams/{{ team_id }}/members" hx-trigger="load" hx-swap="innerHTML">
        <div class="skeleton h-32 w-full"></div>
      </div>
    </div>
  </div>
</section>
