{#def id, title="", open=False #}
<div x-data="{ open: {{ 'true' if open else 'false' }} }">
  <dialog id="{{ id }}" class="modal" :open="open">
    <div class="modal-box">
      {% if title %}
        <h3 class="text-lg font-semibold">{{ title }}</h3>
      {% endif %}
      <div class="py-4">
        {{ content }}
      </div>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn">Close</button>
        </form>
      </div>
    </div>
  </dialog>
</div>
