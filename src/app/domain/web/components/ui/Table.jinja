{#def headers=[], rows=[], striped=True #}
<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
  <table class="table w-full {{ 'table-zebra' if striped }}">
    <thead>
      <tr>
        {% for header in headers %}
          <th>{{ header }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% if rows %}
        {% for row in rows %}
          <tr>
            {% for cell in row %}
              <td>{{ cell }}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      {% else %}
        <tr>
          <td class="py-6 text-center text-sm text-base-content/60" colspan="{{ headers|length }}">
            No records found.
          </td>
        </tr>
      {% endif %}
    </tbody>
  </table>
</div>
