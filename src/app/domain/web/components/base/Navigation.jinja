{#def current="", user_email="" #}
<div class="navbar sticky top-0 z-30 border-b border-base-300 bg-base-100/90 backdrop-blur">
  <div class="navbar-start">
    <div class="dropdown" x-data="{ open: false }">
      <button type="button" class="btn btn-ghost lg:hidden" @click="open = !open">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <ul
        class="menu menu-sm dropdown-content mt-3 w-52 rounded-box bg-base-100 p-2 shadow"
        x-show="open"
        x-transition
        @click.outside="open = false"
      >
        <li>
          <a
            href="/dashboard"
            hx-get="/dashboard"
            hx-target="#page-shell"
            hx-select="#page-shell"
            hx-swap="outerHTML"
            hx-push-url="true"
          >
            Dashboard
          </a>
        </li>
        <li>
          <a
            href="/teams"
            hx-get="/teams"
            hx-target="#page-shell"
            hx-select="#page-shell"
            hx-swap="outerHTML"
            hx-push-url="true"
          >
            Teams
          </a>
        </li>
        <li>
          <a
            href="/users"
            hx-get="/users"
            hx-target="#page-shell"
            hx-select="#page-shell"
            hx-swap="outerHTML"
            hx-push-url="true"
          >
            Users
          </a>
        </li>
        <li>
          <a
            href="/profile"
            hx-get="/profile"
            hx-target="#page-shell"
            hx-select="#page-shell"
            hx-swap="outerHTML"
            hx-push-url="true"
          >
            Profile
          </a>
        </li>
        <li>
          <a
            href="/settings"
            hx-get="/settings"
            hx-target="#page-shell"
            hx-select="#page-shell"
            hx-swap="outerHTML"
            hx-push-url="true"
          >
            Settings
          </a>
        </li>
      </ul>
    </div>
    <a
      href="/"
      class="btn btn-ghost text-lg font-semibold tracking-tight"
      hx-get="/"
      hx-target="#page-shell"
      hx-select="#page-shell"
      hx-swap="outerHTML"
      hx-push-url="true"
    >
      Litestar
      <span class="ml-2 rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary">
        SSR
      </span>
    </a>
  </div>
  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal px-1">
      <li>
        <a
          href="/dashboard"
          hx-get="/dashboard"
          hx-target="#page-shell"
          hx-select="#page-shell"
          hx-swap="outerHTML"
          hx-push-url="true"
        >
          Dashboard
        </a>
      </li>
      <li>
        <a
          href="/teams"
          hx-get="/teams"
          hx-target="#page-shell"
          hx-select="#page-shell"
          hx-swap="outerHTML"
          hx-push-url="true"
        >
          Teams
        </a>
      </li>
      <li>
        <a
          href="/users"
          hx-get="/users"
          hx-target="#page-shell"
          hx-select="#page-shell"
          hx-swap="outerHTML"
          hx-push-url="true"
        >
          Users
        </a>
      </li>
      <li>
        <a
          href="/profile"
          hx-get="/profile"
          hx-target="#page-shell"
          hx-select="#page-shell"
          hx-swap="outerHTML"
          hx-push-url="true"
        >
          Profile
        </a>
      </li>
      <li>
        <a
          href="/settings"
          hx-get="/settings"
          hx-target="#page-shell"
          hx-select="#page-shell"
          hx-swap="outerHTML"
          hx-push-url="true"
        >
          Settings
        </a>
      </li>
    </ul>
  </div>
  <div class="navbar-end gap-2">
    <div class="hidden text-sm text-base-content/70 md:block">{{ user_email }}</div>
    <form method="post" action="/api/access/logout" hx-post="/api/access/logout" hx-swap="none">
      <button type="submit" class="btn btn-ghost">Logout</button>
    </form>
  </div>
</div>
