{#def title="", description="", keywords="", show_nav=True, body_class="", request=None #}
<!DOCTYPE html>
<html lang="en" data-theme="litestar" class="min-h-full">
  <head>
    <base.Head title={{ title }} description={{ description }} keywords={{ keywords }} />
    <base.CSRFToken as_meta={{ True }} />
    {{ vite_hmr() }}
    {{ vite('resources/main.css') }}
  </head>
  <body class="min-h-full {{ body_class }}">
    <div id="page-shell" class="min-h-screen bg-base-200" hx-history-elt>
      {% if show_nav %}
        <base.Navigation />
      {% endif %}
      <main id="page-content" class="mx-auto w-full max-w-6xl px-4 py-8 lg:px-8">
        {{ content }}
      </main>
    </div>
    <div id="toast-shell" class="toast toast-top toast-end z-50" aria-live="polite" aria-atomic="true"></div>
    {{ vite('resources/main.js') }}
  </body>
</html>
