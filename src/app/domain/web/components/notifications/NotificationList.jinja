{#def notifications=[] #}
<div class="space-y-3">
  {% if notifications %}
    {% for notification in notifications %}
      <div class="rounded-box border border-base-300/70 bg-base-100 p-3">
        <notifications.NotificationItem notification={{ notification }} />
      </div>
    {% endfor %}
  {% else %}
    <div class="text-sm text-base-content/60">No notifications right now.</div>
  {% endif %}
</div>
