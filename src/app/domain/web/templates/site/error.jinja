<base.Layout title="Something went wrong" description="Error" keywords="error" request={{ request }}>
  <div class="flex min-h-[60vh] items-center justify-center">
    <div class="card w-full max-w-lg bg-base-100 shadow-sm">
      <div class="card-body text-center">
        <h1 class="text-3xl font-semibold">Something went wrong</h1>
        <p class="text-base-content/70">We could not complete your request.</p>
        <div class="mt-4 text-left">
          {% with message=message, title="Error", variant="error" %}
            {% include "partials/feedback.jinja" %}
          {% endwith %}
        </div>
        <div class="card-actions justify-center">
          <button type="button" class="btn btn-ghost" onclick="window.history.back()">
            Go back
          </button>
        </div>
      </div>
    </div>
  </div>
</base.Layout>
