<base.Layout title="Server error" description="Server error" keywords="server error" request={{ request }}>
  <div class="flex min-h-[60vh] items-center justify-center">
    <div class="card w-full max-w-lg bg-base-100 shadow-sm">
      <div class="card-body text-center">
        <h1 class="text-3xl font-semibold">Server error</h1>
        <p class="text-base-content/70">Something went wrong on our side. Please try again.</p>
        <div class="mt-4 text-left">
          {% with message=message, title="Server error", variant="error" %}
            {% include "partials/feedback.jinja" %}
          {% endwith %}
        </div>
        <div class="card-actions justify-center">
          <button type="button" class="btn btn-ghost" onclick="window.location.reload()">
            Try again
          </button>
        </div>
      </div>
    </div>
  </div>
</base.Layout>
